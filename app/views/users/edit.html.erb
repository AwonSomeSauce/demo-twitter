<% provide(:title, 'Edit Profile') %>

<div class="signup-form-container">
  <h1>Edit Profile</h1>
  <p>Update your account information below.</p>

  <%= form_with(model: @user) do |f| %>
    <%= render 'shared/error_messages' %>

    <div class="form-group">
      <%= f.label :name, "Full Name" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Update your full name" %>
    </div>

    <div class="form-group">
      <%= f.label :email, "Email Address" %>
      <%= f.email_field :email, class: "form-control", placeholder: "Update your email" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "New Password" %>
      <%= f.password_field :password, class: "form-control", placeholder: "Enter a new password (optional)" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm New Password" %>
      <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Re-enter the new password" %>
    </div>

    <div class="form-group">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>